#!/bin/bash
# +----------------------------------------------------------------------------+
# | CoreLAB v0.1 - Modular Processor Simulation Framework                      |
# | Copyright (C) 2026 Pozsar Zsolt <pozsarzs@gmail.com>                       |
# | install                                                                    |
# | Installer script                                                           |
# +----------------------------------------------------------------------------+

SOFTWARE_NAME="CoreLAB"
SOFTWARE_VERSION=$(head -n 1 document/VERSION)
COPYRIGHT_TEXT=$(cat document/copyright)
OPT_DIR="/opt/${SOFTWARE_NAME}"
TARGET_BASE_DIR="/usr/local"

TARGET_DIRECTORIES="$TARGET_BASE_DIR/bin \
                    $TARGET_BASE_DIR/share/applications \
                    $TARGET_BASE_DIR/share/man/man1"
EXECUTABLES="clioport clmemory clprocessor corelab lhelp"
ICON_SIZES="16x16 24x24 32x32 48x48 64x64 scalable"
ICON_CATEGORIES="apps mimetypes"
ICON_TARGET_BASE="$TARGET_BASE_DIR/share/icons/hicolor"
ICON_SOURCE_BASE="$CURRENT_DIR/desktop"
MIME_TARGET_DIR="$TARGET_BASE_DIR/share/mime/packages"
MIME_SOURCE_DIR="$CURRENT_DIR/desktop"

echo "--------------------------------------------------------------------------------"
echo "$SOFTWARE_NAME $SOFTWARE_VERSION installer script"
echo "$COPYRIGHT_TEXT"
echo "--------------------------------------------------------------------------------"

if [ $(whoami) != 'root' ]; then echo 'ERROR: You are not root!'; exit; fi

echo "  This program is free software: you can redistribute it and/or modify it
under the terms of the European Union Public License 1.2 version.

  This program is distributed in the hope that it will be useful, but WITHOUT
ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
FOR A PARTICULAR PURPOSE."
echo "--------------------------------------------------------------------------------"
sleep 1

echo "Copying files..."
cp -a . "$OPT_DIR"

echo "Creating links..."
cd "$OPT_DIR"
CURRENT_DIR=$(pwd)

# directories
for dir in $TARGET_DIRECTORIES
do
  mkdir -p "$dir" 2> /dev/null
done

# binaries
echo -n "Binaries      ["
for file in $EXECUTABLES
do
  BIN_PATH="$CURRENT_DIR/$file"
  if [ -f "$BIN_PATH" ]; then
    ln -sf "$BIN_PATH" "$TARGET_BASE_DIR/bin/$file" 2> /dev/null
    echo -n "."
  fi
done
echo "]"  

# desktop files
echo -n "Desktop files ["
for file in $EXECUTABLES
do
  DESKTOP_PATH="$CURRENT_DIR/desktop/$file.desktop"
  if [ -f "$DESKTOP_PATH" ]; then
    ln -sf "$DESKTOP_PATH" "$TARGET_BASE_DIR/share/applications/$file.desktop" 2> /dev/null
    echo -n "."
  fi
done
echo "]"  

# manuals
echo -n "Manuals       ["
for file in $EXECUTABLES
do
  MAN_PATH="$CURRENT_DIR/manual/$file.1"
  if [ -f "$MAN_PATH" ]; then
    ln -sf "$MAN_PATH" "$TARGET_BASE_DIR/share/man/man1/$file.1" 2> /dev/null
    echo -n "."
  fi
done
echo "]"  

# icon files
ICON_SOURCE_BASE="$CURRENT_DIR/desktop"
echo -n "Icon files    ["
for category in $ICON_CATEGORIES
do
  for size in $ICON_SIZES
  do
    SOURCE_ICON_DIR="$ICON_SOURCE_BASE/$size/$category"
    TARGET_ICON_DIR="$ICON_TARGET_BASE/$size/$category"
    if [ -d "$SOURCE_ICON_DIR" ]; then
      mkdir -p "$TARGET_ICON_DIR" 2> /dev/null
      for icon_file in "$SOURCE_ICON_DIR"/*
      do
        if [ -f "$icon_file" ]; then
          icon_name=$(basename "$icon_file")
          ln -sf "$icon_file" "$TARGET_ICON_DIR/$icon_name" 2> /dev/null
          echo -n "."
        fi
      done
    fi
  done
done
echo "]"  

# mime files
MIME_SOURCE_DIR="$CURRENT_DIR/desktop"
echo -n "MIME files    ["
if [ -d "$MIME_SOURCE_DIR" ]; then
  mkdir -p "$MIME_TARGET_DIR" 2> /dev/null
  for xml_file in "$MIME_SOURCE_DIR"/*.xml
  do
    if [ -f "$xml_file" ]; then
      xml_name=$(basename "$xml_file")
      ln -sf "$xml_file" "$MIME_TARGET_DIR/$xml_name" 2> /dev/null
      echo -n "."
    fi
  done
fi
echo -e "]\n"

update-mime-database "$TARGET_BASE_DIR/share/mime"
gtk-update-icon-cache -t "$ICON_TARGET_BASE"

echo -e "Done.\n"
