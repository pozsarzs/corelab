ORG 0000h

START:
    LD SP, 2000h

    LD HL, 1000h
    LD DE, 100Fh
    LD C, 8
    LD B, 0

LOOP:
    LD A, (HL)
    ADD A, B
    
    LD (DE), A
    
    INC HL
    DEC DE
    INC B
    
    DEC C
    JP NZ, LOOP     ; JR NZ helyett JP NZ (Abszolút ugrás, 3 bájt - Opkód: C2)

HALT_LOOP:
    HALT
    JP HALT_LOOP    ; JR helyett JP (Abszolút ugrás, 3 bájt - Opkód: C3)