; *** Z80 assembly ***
; The program reads the 8 bytes from address 1000h, adds its own sequence number
; to each one (as a kind of transformation), and then saves the results in
; reverse order starting at address 1008h.

ORG	0000h			; Program starts from the beginning of ROM, at address 0000h

START:
	LD	SP, 2000h	; Initialize Stack Pointer into RAM (for safety/standard practice)

				; Prepare registers for data copying and transformation
	LD	HL, 1000h	; HL = Source address pointer (4096 = 1000h)
	LD	DE, 100Fh	; DE = End of destination address (4104 + 7 = 410Fh) -> filling backwards
	LD	C, 8		; C = Loop counter (8 bytes of data to process)
	LD	B, 0		; B = Transformation value / index (ranges from 0 to 7)

LOOP:
	LD	A, (HL)		; Load current data byte from source (pointed by HL) into Accumulator
	ADD	A, B		; Transformation: add the sequence index (B) to the data
	
	LD	(DE), A		; Store the result at the destination address (pointed by DE)
	
	INC	HL		; Increment source pointer (HL -> next byte)
	DEC	DE		; Decrement destination pointer (DE -> filling in reverse order)
	INC	B		; Increment transformation index (B)
	
	DEC	C		; Decrement loop counter (C)
	JP	NZ, LOOP	; If C is not 0, jump back and repeat the loop

HALT_LOOP:
	HALT			; Halt CPU / Stop program execution
	JP	HALT_LOOP	; Safety infinite loop (in case an interrupt wakes the CPU)
