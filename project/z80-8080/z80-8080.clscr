#!/usr/bin/corelab -r
# +----------------------------------------------------------------------------+
# | CoreLAB v0.1 - Modular Processor Simulation Framework                      |
# | Copyright (C) 2026 Pozsar Zsolt <pozsarzs@gmail.com>                       |
# | z80-8080.clscr                                                             |
# | Running the same procedure on two different processors                     |
# +----------------------------------------------------------------------------+

	SETV	$Title	"RUNNING THE SAME PROCEDURE ON TWO DIFFERENT PROCESSORS"

	DEFP	($Title)
	PRNT	"%v"

; Create and initialize variables

	SETV	$messages[0]		"Starting Z80 simulation..."
	SETV	$messages[1]		"Switching processor to i8080"
	SETV	$messages[2]		"Starting 8080 simulation..."
	SETV	$messages[3]		"- Simulation finished. Results:"
	SETV	$messages[4]		"- Index\tInput\tOutput"
	SETV	$messages[5]		"- Executed instructions: "

	SETV	$i			0
LOOP1:
	SETV	$indata[$i]		$BRND		; random byte value
	INCR	$i
	COMP	$i			8
	JPLT	LOOP1

	SETV	$i			0
LOOP2:
	SETV	$outdata[$i]		0
	INCR	$i
	COMP	$i			8
	JPLT	LOOP2

; Create simulation environment	and attach to system bus

	CRTE	$ProcZ80		TZ80CPU		; processor objects
	SETP	$ProcZ80.Enabled	true
	ATTH	$ProcZ80

	CRTE	$Proc8080		T8080CPU
	SETP	$Proc8080.Enabled	false

	CRTE	$ROM			TMemory		; system ROM object
	SETP	$ROM.AddressRangeSize	4096
	SETP	$ROM.MemoryMode		mmROM
	SETP	$ROM.Enabled		true
	ATTH	$ROM			0h		; first address = 0h

	CRTE	$RAM			TMemory		; system RAM object
	SETP	$RAM.AddressRangeSize	61440
	SETP	$RAM.MemoryMode		mmRAM
	SETP	$RAM.Enabled		true
	ATTH	$RAM			1000h		; first address = 1000h

	CRTE	$OutDev			TLED8		; output device object
	SETP	$OutDev.Enabled		true
	ATTH	$OutDev			14h		; address = 14h

; Running a sample program on both processors

	DEFP	("z80-8080.hex", 100h, 0)		; count is not determinated
	CALM	$ROM.LoadFromStream			; load test program to ROM

	DEFP	($messages[0])				; run simulation
	PRNT	"%v"
	CALL	SIM
	DEFP	($messages[1])
	PRNT	"%v"

	CALM	$RAM.Reset				; change processor
	DETH	$ProcZ80
	ATTH	$Proc8080
	DEFP	($messages[2])
	PRNT	"%v"
	CALL	SIM

; Detach and destroy simulation environment

	DETH	$OutDev					; detach  objects
	DETH	$RAM
	DETH	$ROM
	DETH	$Proc8080

	DEST	$OutDev					; destroy objects
	DEST	$RAM
	DEST	$ROM
	DEST	$Proc8080
	DEST	$ProcZ80

	EXIT
	END

;--------------------------------------------------------------------------------
; SIMULATION SUBROUTINE
;--------------------------------------------------------------------------------
SIM:
	SETV	$i			0
	SETV	$addr			4096
LOOP3:							; load input data to RAM
	DEFP	($addr, $indata[$i])
	CALM	$RAM.WriteMemory
	INCR	$addr
	INCR	$i
	COMP	$i			8
	JPLT	LOOP3
	SRUN						; run simulation
	SETV	$i			0
	SETV	$addr			4104
	DEFP	($messages[3])
	PRNT	"%v"
	DEFP	($messages[4])
	PRNT	"%v"
	SETV	$i			0
LOOP4:
	DEFP	($addr)
	CALM	$outdata[$i]		$RAM.ReadMemory
	DEFP	($i, $indata[$i], $outdata[$i])
	PRNT	"%v \t %v \t %v"
	INCR	$addr
	INCR	$i
	COMP	$i			8
	JPLT	LOOP4
	SSTP						; stop simulation
	DEFP	($messages[5], $ICNT)			; instruction counter value
	PRNT	"%v %v"
	RETURN
;--------------------------------------------------------------------------------
