#!/usr/bin/corelab -r
# +----------------------------------------------------------------------------+
# | CoreLAB v0.1 - Modular Processor Simulation Framework                      |
# | Copyright (C) 2026 Pozsar Zsolt <pozsarzs@gmail.com>                       |
# | z80-8080.clscr                                                             |
# | Running the same procedure on two different processors                     |
# +----------------------------------------------------------------------------+

	title		"RUNNING THE SAME PROCEDURE ON TWO DIFFERENT PROCESSORS"
	project		"z80-8080.clprj"

# MAIN PROGRAM
	start
	print		$TITLE
	print		""

# create and initialize variables
	create	TVar	i
	create	TArray	indata 8
	create	TArray	outdata 8
	create	TArray	messages 6

	let		$messages[0] "Starting Z80 simulation..."
	let		$messages[1] "Switching processor to i8080"
	let		$messages[2] "Starting 8080 simulation..."
	let		$messages[3] "- Simulation finished. Results:"
	let		$messages[4] "- Index\tInput\tOutput"
	let		$messages[5] "- Executed instructions: "

	let		$i 0
loop1:	let		$indata[$i] $BRND
	inc		$i
	goto		loop1 $i<8 

	let		$i 0
loop2:	let		$outdata[$i] 0
	inc		$i
	goto		loop2 $i<8 

# create simulation environment	and attach to system bus
	create	TZ80CPU	myZ80
	create	T8080CPU my8080
	create	TMemory	myROM 4096 RO
	create	TMemory	myRAM 61440
	create	TLED8	myLEDs
	attach	myZ80
	attach	myROM	0
	attach	myRAM	1000h
	attach	myLEDs	14h

# simulations
	load	myROM	"z80-8080.hex" 100h           # load test program to ROM
	print		$messages[0]
	call		sim
	print		$messages[1]
	reset	myRAM
	detach	myZ80	                                      # change processor
	attach	my8080
	print		$messages[2]
	call		sim

# detach component from system bus and destroy
	detach	my8080
	detach	myLEDs
	detach	myRAM
	detach	myROM
	destroy	my8080
	destroy	myLEDs
	destroy	myRAM
	destroy	myROM

# destroy variables
	destroy	i
	destroy	indata
	destroy	outdata
	destroy	messages

	exit 0
	end

# SIMULATION SUBROUTINE
sim:	let		$i 0                            # load input data to RAM
	create	TVar 	addr
	let		$addr 4096
loop3:	set		myRAM[$addr] $indata[$i]
	inc		$addr
	inc		$i
	goto		loop3 $i<8	
	run                                                     # run simulation
	let		$i 0
	let		$addr 4104
	print		$messages[3]
	print		$messages[4]
loop4:	get		myRAM[$addr] $outdata[$i]
	print		$i "\t" $indata[$i] "\t" $outdata[$i]
	inc		$addr
	inc		$i
	goto		loop4 $i<8	
	destroy	addr
	print		$messages[5] $ICNT
	print		""
	return
