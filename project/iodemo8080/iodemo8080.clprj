<?xml version="1.0" encoding="utf-8"?>
<CoreLAB_Workspace version="1.0">
  <Modules>
    <TCPU id="Processor" type="cpu_8080">
      <Enabled>true</Enabled>
      <AttachedToBus>true</AttachedToBus>
    </TCPU>
    <TIOPort id="Keyboard" type="ioport_button16bcd">
      <BaseAddress>000129</BaseAddress>
      <DataInMode>lmBCD</DataInMode>
      <DataInNegation>false</DataInNegation>
      <DataOutMode>lmBCD</DataOutMode>
      <DataOutNegation>false</DataOutNegation>
      <Enabled>true</Enabled>
      <IntVector>07</IntVector>
      <SelMode>lmBCD</SelMode>
      <SelNegation>false</SelNegation>
      <PanelCaption>MyKeys</PanelCaption>
      <PanelSize>320-240</PanelSize>
      <PanelPosition>0-0</PanelPosition>
      <AttachedToBus>true</AttachedToBus>
    </TIOPort>
    <TIOPort id="Console" type="ioport_console">
      <BaseAddress>000128</BaseAddress>
      <DataInMode>lmBCD</DataInMode>
      <DataInNegation>false</DataInNegation>
      <DataOutMode>lmBCD</DataOutMode>
      <DataOutNegation>false</DataOutNegation>
      <Enabled>true</Enabled>
      <IntVector>15</IntVector>
      <SelMode>lmBCD</SelMode>
      <SelNegation>false</SelNegation>
      <PanelCaption>MyConsole</PanelCaption>
      <PanelSize>320-240</PanelSize>
      <PanelPosition>0-0</PanelPosition>
      <AttachedToBus>true</AttachedToBus>
    </TIOPort>
    <TIOPort id="Display" type="ioport_disp1hexbcd">
      <BaseAddress>000144</BaseAddress>
      <DataInMode>lmBCD</DataInMode>
      <DataInNegation>false</DataInNegation>
      <DataOutMode>lmBCD</DataOutMode>
      <DataOutNegation>false</DataOutNegation>
      <Enabled>true</Enabled>
      <IntVector>00</IntVector>
      <SelMode>lmBCD</SelMode>
      <SelNegation>false</SelNegation>
      <PanelCaption>MyNum</PanelCaption>
      <PanelSize>320-240</PanelSize>
      <PanelPosition>0-0</PanelPosition>
      <AttachedToBus>true</AttachedToBus>
    </TIOPort>
    <TMemory id="RAM" type="memory_standard">
      <BaseAddress>00</BaseAddress>
      <AddressRangeSize>1024</AddressRangeSize>
      <MemoryMode>mmRAM</MemoryMode>
      <Enabled>true</Enabled>
      <AttachedToBus>true</AttachedToBus>
    </TMemory>
  </Modules>
</CoreLAB_Workspace>
