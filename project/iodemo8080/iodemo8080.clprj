<?xml version="1.0" encoding="UTF-8"?>
<CoreLAB_Workspace version="1.0">
<!-- Run CoreLAB 8080 Demo program with script -->
  <Modules>
    <!-- Console IO Port -->
    <TIOPort id="Console" type="ioport_console">
      <BaseAddress>128</BaseAddress> <!-- 80H -->
      <IntVector>215</IntVector> <!-- D7H -->
      <Enabled>true</Enabled>
    </TIOPort>
    <!-- Keyboard IO Port -->
    <TIOPort id="Keyboard" type="ioport_button16bcd">
      <BaseAddress>129</BaseAddress> <!-- 81H -->
      <IntVector>207</IntVector> <!-- CFH -->
      <Enabled>true</Enabled>
    </TIOPort>
    <!-- Display IO Port -->
    <TIOPort id="Display" type="ioport_disp1hexbcd">
      <BaseAddress>144</BaseAddress> <!-- 90H -->
      <Enabled>true</Enabled>
    </TIOPort>
    <!-- RAM Memory -->
    <TMemory id="RAM" type="memory_standard">
      <BaseAddress>0</BaseAddress>
      <AddressRangeSize>1024</AddressRangeSize>
      <MemoryMode>mmRAM</MemoryMode>
      <Enabled>true</Enabled>
    </TMemory>
    <!-- CPU Processor -->
    <TCPU id="Processor" type="cpu_8080">
      <Enabled>true</Enabled>
    </TCPU>
  </Modules>
  <Connections>
    <!-- Attach to system bus -->
    <SysBusConnection>
      <Source module="SysBus" />
      <Target module="Console"/>
    </SysBusConnection>
    <SysBusConnection>
      <Source module="SysBus" />
      <Target module="Keyboard"/>
    </SysBusConnection>
    <SysBusConnection>
      <Source module="SysBus" />
      <Target module="Display"/>
    </SysBusConnection>
    <SysBusConnection>
      <Source module="SysBus" />
      <Target module="RAM"/>
    </SysBusConnection>
    <SysBusConnection>
      <Source module="SysBus" />
      <Target module="Processor"/>
    </SysBusConnection>
  </Connections>
</CoreLAB_Workspace>
