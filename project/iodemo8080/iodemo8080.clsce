#!/usr/bin/corelab -r
; +----------------------------------------------------------------------------+
; | CoreLAB v0.1 - Modular Processor Simulation Framework                      |
; | Copyright (C) 2026 Pozsar Zsolt <pozsarzs@gmail.com>                       |
; | iodemo8080.clsce                                                           |
; | Run CoreLAB 8080 Demo program with script                                  |
; +----------------------------------------------------------------------------+

; Show internal modules
	SHBL					; open BusLogger
	SHRL					; open RunLogger
	SHIL					; open IntLogger

; Create, initialize and attach modules to system bus
	CRIO	ioport_console Console		; module name
	CFIO	Console.BaseAddress 80		; base address
	CFIO	Console.IntVector D7		; interrupt vector
	RNIO	Console "Console"		; panel caption
	ATIO	Console				; attach to bus

	CRIO	ioport_button16bcd Keyboard	; module name
	CFIO	Keyboard.BaseAddress 81		; base address
	CFIO	Console.IntVector CF		; interrupt vector
	RNIO	Keyboard "Keyboard"		; panel caption
	ATIO	Keyboard			; attach to bus
	
	CRIO	ioport_disp1hexbcd Display	; module name
	CFIO	Display.BaseAddress 90		; base address
	RNIO	Display "Display"		; panel caption
	ATIO	Display				; attach to bus

	CRME	memory_standard RAM		; module name
	CFME	RAM.BaseAddress 0		; base address
	CFME	RAM.AddressRangeSize 1024	; size
	CFME	RAM.MemoryMode mmRAM		; mode
	LDME	RAM "iodemo8080.hex"		; load program
	ATME	RAM				; attach to bus
	
	CRPU	cpu_8080 Processor		; module name
	ATPU	Processor			; attach to bus

	ENIO	Console				; enable modules
	ENIO	Keyboard
	ENIO	Display
	ENME	RAM
	ENPU	Processor

; Show internal modules
	SHRV	Processor			; open RegViewer
	SHHV	RAM				; open HexViewer

; Run simulation
	RUN	100				; run with 100 ms delay

; Disable modules
	DIIO	Console
	DIIO	Keyboard
	DIIO	Display
	DIME	RAM
	DIPU	Processor

; Detach from bus and destroy modules
	DTIO	Console
	DSIO	Console
	DTIO	Keyboard
	DSIO	Keyboard
	DTIO	Display
	DSIO	Display
	DTME	RAM
	DSME	RAM
	DTPU	Processor
	DSPU	Processor
	END
