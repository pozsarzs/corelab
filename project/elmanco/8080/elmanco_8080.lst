			; ---- CONSTANTS ----
			PRT_BTN	EQU	10h		; I/O base addresses
			PRT_DSP	EQU	20h
			PRT_LED	EQU	25h
			
			; ---- ENTRIES ----
				ORG	0000h
0000	C3 00 01		JMP     START		; reset vector

        			ORG     0008h
0008	C3 6D 01        	JMP     BTNINT		; RST 1 interrupt vector

			; ---- MAIN PROGRAM ----
        			ORG     0100h
			START:				; START MAIN PROGRAM
0100	31 00 04		LXI     SP, 0400h       ; set stack pointer to top of 1KB RAM
0103	FB			EI			; enable interrupt
			
			LPMAIN:				; MAIN LOOP
			; -- DISPLAY --
0104	CD E9 01		CALL	DSPPROC		; call display handler
0107	CD FF 01		CALL	LEDPROC		; call LED handler
			
			; -- CHECK RUN STATE --
010A	21 31 02		LXI	H, MACHINE	; H = machine state address
010D	7E			MOV	A, M		; A = machine state
010E	5F			MOV	E, A		; store machine state in E
010F	FE 02			CPI	2		; check run state
0111	C2 34 01		JNZ	SKRUN		; in other skip this block
0114	0E 04			MVI	C, 4		; counter = 4
			LPRUN:
0116	0D			DCR	C		; decrement counter
0117	21 2D 02		LXI	H, REELS	; H = reels variable address
011A	06 00			MVI	B, 0		; B = 0 (upper byte)
011C	09			DAD	B		; HL = HL + BC
011D	7E			MOV	A, M		; A = status of a reel
011E	FE 01			CPI	1
0120	CA 2E 01		JZ	NXTRUN		; if it is stopped go next
0123	21 29 02 		LXI	H, DISPLAY	; H = load display variable address
0126	06 00			MVI	B, 0		; B = 0 (upper byte)
0128	09			DAD	B		; HL = HL + BC
0129	7E			MOV	A, M		; A = digit value
012A	3C			INR	A		; increment value
012B	E6 0F			ANI	0Fh		; masking value (0-FH)
012D	77			MOV	M, A		; store digit value
			NXTRUN:
012E	79			MOV	A, C		; A = counter
012F	FE 00			CPI	0		; if counter > 0 then go back
0131	C2 16 01		JNZ	LPRUN
			SKRUN:				; SKIP this block
			
			; -- CHECK WIN STATE --
0134	7B			MOV	A, E		; A = machine state
0135	FE 01			CPI	1		; check "STAND" machine state
0137	C2 5F 01		JNZ	SKWIN		; in other skip this block
			
013A	0E 03			MVI	C, 3		; counter = 3
013C	21 29 02		LXI	H, DISPLAY	; H = display variable address
013F	56			MOV	D, M		; D = digit value
			LPWIN:
0140	23			INX	H		; increment variable address
0141	7E			MOV	A, M		; A = next digit value
0142	BA			CMP	D		; compare first and next value
0143	C2 57 01		JNZ	LOSE		; if not equivalent go to lose
0146	0D			DCR	C		; decrement counter
0147	79			MOV	A, C		; A = counter
0148	FE 00			CPI	0		; if counter > 0 then go back
014A	C2 40 01		JNZ	LPWIN
014D	21 31 02		LXI	H, MACHINE	; H = machine variable address 
0150	1E 03			MVI	E, 3		; set machine state to "WIN"
0152	36 03			MVI	M, 3		; set machine state to "WIN"
0154	C3 5F 01		JMP	SKWIN		; exit from block
			LOSE:
0157	21 31 02		LXI	H, MACHINE	; H = machine variable address 
015A	1E 04			MVI	E, 4		; set machine state to "LOSE"
015C	36 04			MVI	M, 4		; set machine state to "LOSE"
			SKWIN:				; SKIP this block
			
			; -- CHECK EXIT STATE --
015F	21 31 02		LXI	H, MACHINE	; H = machine state address
0162	7E			MOV	A, M		; A = machine state
0163	FE 05			CPI	5
0165	CA 6B 01		JZ	EXIT		; if machine state is "EXIT" go exit
			SKDELAY:
0168	C3 04 01		JMP	LPMAIN		; go back
			EXIT:
016B	F3			DI			; disable interrupt
016C	76			HLT			; exit program
			
			; ---- BUTTON HANDLER ----
			BTNINT:
016D	F3			DI
016E	F5		        PUSH    PSW
016F	E5		        PUSH    H
0170	C5		        PUSH	B
0171	DB 10		        IN      PRT_BTN
0173	47		        MOV	B, A
			B0_BTN:				; START MACHINE
0174	78			MOV	A, B
0175	E6 01		        ANI	01H
0177	CA 8D 01	        JZ	B1_BTN
			
017A	AF		        XRA	A		; unlock all reels
017B	21 2D 02		LXI	H, REELS	; H = reels state address
017E	77			MOV	M, A		; set reel states to "SPINNING"
017F	23			INX	H
0180	77			MOV	M, A
0181	23			INX	H
0182	77			MOV	M, A
0183	23			INX	H
0184	77			MOV	M, A
			
0185	21 31 02		LXI	H, MACHINE	; H = machine state address
0188	36 02			MVI	M, 2		; set machine state to "RUN"
018A	C3 D0 01		JMP	RLSBTN
			B1_BTN:				; STOP REEL #1
018D	78			MOV	A, B
018E	E6 02		        ANI	02H
0190	CA 9B 01		JZ	B2_BTN
0193	21 2D 02		LXI	H, REELS	; H = reels state address
0196	36 01			MVI	M, 1		; set reel state to "STOPPED"
0198	C3 D0 01		JMP	RLSBTN
			B2_BTN:				; STOP REEL #2
019B	78			MOV	A, B
019C	E6 04		        ANI	04H
019E	CA A9 01		JZ	B3_BTN
01A1	21 2E 02		LXI	H, REELS + 1	; H = reels state address
01A4	36 01			MVI	M, 1		; set reel state to "STOPPED"
01A6	C3 D0 01		JMP	RLSBTN
			B3_BTN:				; STOP REEL #3
01A9	78			MOV	A, B
01AA	E6 08		        ANI	08H
01AC	CA B7 01		JZ	B4_BTN
01AF	21 2F 02		LXI	H, REELS + 2	; H = reels state address
01B2	36 01			MVI	M, 1		; set reel state to "STOPPED"
01B4	C3 D0 01		JMP	RLSBTN
			B4_BTN:				; STOP REEL #4
01B7	78			MOV	A, B
01B8	E6 10		        ANI	10H
01BA	CA C5 01		JZ	B7_BTN
01BD	21 30 02		LXI	H, REELS + 3	; H = reels state address
01C0	36 01			MVI	M, 1		; set reel state to "STOPPED"
01C2	C3 D0 01		JMP	RLSBTN
			B7_BTN:				; EXIT MACHINE
01C5	78			MOV	A, B
01C6	E6 80		        ANI	80H
01C8	CA D0 01		JZ	RLSBTN
01CB	21 31 02		LXI	H, MACHINE	; H = machine state address
01CE	36 05			MVI	M, 5		; set machine state to "EXIT"
			RLSBTN:
01D0	21 2D 02		LXI	H, REELS	; check all reel states
01D3	7E			MOV	A, M
01D4	23			INX	H
01D5	86			ADD	M
01D6	23			INX	H
01D7	86			ADD	M
01D8	23			INX	H
01D9	86			ADD	M
01DA	FE 04			CPI	4
01DC	C2 E4 01		JNZ	RETBTN		; if all are "STOPPED", set machine state to "STOP"
01DF	21 31 02		LXI	H, MACHINE	; H = machine state address
01E2	36 01			MVI	M, 1		; machine state = 1
			RETBTN:
01E4	C1			POP	B
01E5	E1		        POP     H
01E6	F1		        POP     PSW
01E7	FB		        EI
01E8	C9		        RET
			
			; ---- DISPLAY HANDLER ----
			DSPPROC:
01E9	0E 04			MVI	C, 4		; counter = 4
			DSPLOOP:
01EB	0D			DCR	C		; decrement counter
01EC	79			MOV	A, C		;
01ED	D3 21			OUT	PRT_DSP + 1	; select display digit (3..0)
01EF	21 29 02		LXI	H, DISPLAY	; H = variable address
01F2	06 00			MVI	B, 0		; B = 0
01F4	09			DAD	B		; HL = HL + BC
01F5	7E			MOV	A, M		; load digit value
01F6	D3 20			OUT	PRT_DSP		; write to display
01F8	79			MOV	A, C		; A = counter
01F9	FE 00			CPI	0
01FB	C2 EB 01		JNZ	DSPLOOP		; if not zero go back
01FE	C9			RET
			
			; ---- LED HANDLER ----
			LEDPROC:
01FF	21 31 02		LXI	H, MACHINE	; H = machine state address
0202	7E			MOV	A, M		; A = machine state
0203	FE 04			CPI	4
0205	C2 0D 02		JNZ	ST3LED
0208	3E 81			MVI	A, 81H		; at state "LOSE"
020A	D3 25			OUT	PRT_LED
020C	C9			RET
			ST3LED:
020D	FE 03			CPI	3
020F	C2 17 02		JNZ	ST2LED
0212	3E 7E			MVI	A, 7EH		; at state "WIN"
0214	D3 25			OUT	PRT_LED
0216	C9			RET
			ST2LED:
0217	FE 02			CPI	2
0219	C2 25 02		JNZ	ST1LED
021C	21 32 02		LXI	H, RUNLGHT	; at state "RUN"
021F	7E			MOV	A, M
0220	2F			CMA
0221	77			MOV	M, A
0222	D3 25			OUT	PRT_LED
0224	C9			RET
			ST1LED:
0225	AF			XRA	A		; at other states
0226	D3 25			OUT	PRT_LED
0228	C9			RET
			
			; ---- VARIABLES ----
0229	01 02 03 04	DISPLAY	DB	1, 2, 3, 4	; display digits in BCD (0000 nnnn) 
022D	00 00 00 00	REELS	DB	0, 0, 0, 0	; 0=spinning, 1=stopped
0231	00		MACHINE	DB	0		; machine state: 0..5: wait, stand, run, win, lose, exit
0232	AA		RUNLGHT	DB	AAH		; running light sample (AAH/55H)
				END
