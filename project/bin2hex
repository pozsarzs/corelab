# CHECK DEPENDENCY
chkdep() {
  if command -v $1 >/dev/null 2>&1;
  then
    return 0
  else
    echo -e "\nERROR: The '${1}' is required to use the script."
    return 127
  fi
}

# check dependency
chkdep objcopy; TOBE=$?; if [ $TOBE -ne 0 ]; then exit; fi
# convert file
if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <input.bin> <output.hex>"
    exit 1
fi
objcopy -I binary -O ihex "$1" "$2"
