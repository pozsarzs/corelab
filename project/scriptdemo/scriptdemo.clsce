#!/usr/bin/corelab -r -s
; +----------------------------------------------------------------------------+
; | CoreLAB v0.1 - Modular Processor Simulation Framework                      |
; | Copyright (C) 2026 Pozsar Zsolt <pozsarzs@gmail.com>                       |
; | scriptdemo.clsce                                                           |
; | Demo script                                                                |
; +----------------------------------------------------------------------------+

; --- MAIN PROGRAM ---

	LDRG	R0 1			; R0: Initial value of the loop variable
	LDRG	R1 6			; R1: End of loop limit
	LDRG	RA 0			; RA: Clear accumulator

LOOP:
	CALL	PRINT_HEX		; Subroutine 1: print counter in hex
	ADD	$R0			; Add loop variable to accumulator
	WAIT	800			; Wait 800 ms for visual tracking
	SWAP	$RA $R0	
	INC				; Increment RA by 1
	COMP	$R1			; Compare RA and R1
	SWAP	$RA $R0	
	JPZE	NEXT			; Jump to NEXT label if equal
	JUMP	LOOP			; Unconditional jump to LOOP label

NEXT:
	CALL	DOUBLE			; Subroutine 2: double the final sum
	PRNT	"Final sum: " $RA	; Print final result to console
	EXIT				; Stop main program immediately
	END				; End of main program

; --- SUBROUTINES ---

; Subroutine 1: Convert and print R0 counter in hexadecimal format
PRINT_HEX:
	SWAP	$RA $R0			; Move R0 value to RA
	CONV	R2 16			; Convert RA to base 16, result in R2
	SWAP	$RA $R0			; Swap back so the sum is in RA again
	PRNT	"Counter (HEX): " $R2	; Print counter in hex
	RTRN				; Return to the caller

; Subroutine 2: Multiply the accumulator value
DOUBLE:
	MUL	2			; Multiply accumulator content by 2
	PRNT	"Doubling finished." "" ; Text feedback
	RTRN				; Return to the caller
