#!/bin/bash
# +----------------------------------------------------------------------------+
# | CoreLAB v0.1 - Modular Processor Simulation Framework                      |
# | Copyright (C) 2026 Pozsar Zsolt <pozsarzs@gmail.com>                       |
# | lst2bin                                                                    |
# | Convert list file to binary                                                |
# +----------------------------------------------------------------------------+

# MESSAGES
MSG01="\nERROR: The '%s' is required to use the script.\n"
MSG02="Usage: $0 <input.lst> <output.bin>"
MSG03="Done."

# CHECK DEPENDENCY
chkdep() {
  if command -v $1 >/dev/null 2>&1;
  then
    return 0
  else
    printf "$MSG01\n" $1
    return 127
  fi
}

# check dependency
chkdep awk; TOBE=$?; if [ $TOBE -ne 0 ]; then exit; fi
# check arguments
if [ "$#" -ne 2 ]
then
  echo "$MSG02"
  exit 1
fi
# convert file
awk '
  /^[0-9A-Fa-f]{4}[ \t]/ {
    printf "%s:", $1
    for (i = 2; i <= NF; i++) {
      if ($i ~ /^[0-9A-Fa-f]{2}$/) {
        printf " %s", $i
      } else { break }
    }
    printf "\n"
  }' "$1" | xxd -r > "$2"
echo "$MSG03"
