#!/bin/bash
# +----------------------------------------------------------------------------+
# | CoreLAB v0.1 - Modular Processor Simulation Framework                      |
# | Copyright (C) 2026 Pozsar Zsolt <pozsarzs@gmail.com>                       |
# | hex2bin                                                                    |
# | Convert Intel hexa file to binary                                          |
# +----------------------------------------------------------------------------+

# MESSAGES
MSG01="\nERROR: The '%s' is required to use the script.\n"
MSG02="Usage: $0 <input.hex> <output.bin>"

# CHECK DEPENDENCY
chkdep() {
  if command -v $1 >/dev/null 2>&1;
  then
    return 0
  else
    printf "$MSG01\n" $1
    return 127
  fi
}

# check dependency
chkdep objcopy; TOBE=$?; if [ $TOBE -ne 0 ]; then exit 2; fi
# check arguments
if [ "$#" -ne 2 ]
then
  echo "$MSG02"
  exit 1
fi
# convert file
objcopy -I ihex -O binary "$1" "$2"
