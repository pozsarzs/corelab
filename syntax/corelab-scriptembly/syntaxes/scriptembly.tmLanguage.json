{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "CoreLAB scriptembly",
	"patterns": [
		{
			"include": "#constvar"
		},
		{
			"include": "#shebang"
		},
		{
			"include": "#comment"
		},
		{
			"include": "#group1"
		},
		{
			"include": "#group2"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"constvar": {
			"patterns": [{
				"name": "variable.other.corelab",
				"match": "\\$R[0-9A-F]"
				}]
	        },
			"shebang": {
			"patterns": [{
				"name": "comment.line.shebang",
				"match": "(^#!.*/corelab.*|^@corelab.exe.*|^:eof|^@goto.*)"
				}]
                },
		"comment": {
			"patterns": [{
				"name": "comment.line.corelab",
				"match": "(;.*)"
				}]
                },
                "group1": {
			"patterns": [{
				"name": "class.language.corelab",
				"match": "<T[A-Z]\\w*>"
				}]
                },
		"group2": {
			"patterns": [{
				"name": "keyword.control.corelab",
				"match": "\\b(ADD|AND|ATIO|ATME|ATPU|BIT|CALL|CFIO|CFME|CFPU|CHWD|COMP|CONV|CRIO|CRME|CRPU|DEC|DIIO|DIME|DIPU|DSIO|DSME|DSPU|DTIO|DTME|DTPU|EDME|END|ENIO|ENME|ENPU|EXAP|EXIT|INC|INRG|JPCA|JPNC|JPNZ|JPZE|JUMP|LDME|LDPR|LDRG|LDSC|MUL|MVIO|NMI|NOT|NWPR|NWSC|OR|PRNT|RDIO|RDME|RNIO|RSAP|RSIO|RSME|RSPU|RST|RTRN|RUN|RUSC|RWIO|SESC|SHBL|SHBM|SHHV|SHIL|SHIO|SHL|SHME|SHR|SHRL|SHRV|SHSC|SHSE|STEP|STOP|STSC|SUB|SVME|SVPR|SVSC|SWAP|SZIO|WAIT|WRIO|WRME|XOR)\\b"
				}]
		},
		"strings": {
			"name": "string.quoted.double.corelab",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.corelab",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.scriptembly"
}
