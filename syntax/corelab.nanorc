## | corelab.nanorc                                                            |
## | syntax highlighting file for Nano text editor                             |
## +---------------------------------------------------------------------------+

syntax "corelab"
header "^#!.*/(env +)?corelab*( |$)"
header "@corelab*"
magic "CoreLAB scriptembly"
comment ";"

icolor brightcyan "\<(.*)\>"

## registers:
icolor brightblue "\$R[A-Z0-9]\>"

## instructions:
icolor brightwhite "\<(ADD|AND|ATIO|ATME|ATPU|BIT|CALL|CFIO|CFME|CFPU|CHWD|COMP|CONV|CRIO|CRME|CRPU|DEC|DIIO|DIME|DIPU|DSIO|DSME|DSPU|DTIO|DTME|DTPU|EDME|END|ENIO|ENME|ENPU|EXAP|EXIT|HELP|INC|INRG|JPCA|JPNC|JPNZ|JPZE|JUMP|LDME|LDPR|LDRG|LDSC|MUL|MVIO|NMI|NOT|NWPR|NWSC|OR|PRNT|RDIO|RDME|RNIO|RSAP|RSIO|RSME|RSPU|RST|RTRN|RUN|RUSC|RWIO|SESC|SHBL|SHBM|SHHV|SHIL|SHIO|SHL|SHME|SHR|SHRL|SHRV|SHSC|SHSE|STEP|STOP|STSC|SUB|SVME|SVPR|SVSC|SWAP|SZIO|WAIT|WRIO|WRME|XOR)\>"

## strings:
color brightyellow "["][^"]*[^\\]["]"

## comments:
icolor brightgreen "^;.*|[[:space:]];.*$"

# preprocessor commands:
icolor brightcyan "^#!/.*|[[:space:]]#.*$"
icolor brightcyan "^@.*|[[:space:]]#.*$"
icolor brightcyan "^:.*|[[:space:]]#.*$"
