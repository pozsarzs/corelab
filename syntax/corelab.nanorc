## | corelab.nanorc                                                            |
## | syntax highlighting file for Nano text editor                             |
## +---------------------------------------------------------------------------+

syntax "corelab"
header "^#!.*/(env +)?corelab*( |$)"
header "@corelab*"
magic "CoreLAB scriptembly"
comment ";"

icolor brightcyan "\<(.*)\>"

## registers:
icolor brightblue "\$R[A-Z0-9]\>"

## instructions:
icolor brightwhite "\<(ATIO|ATME|ATPU|CRIO|CFIO|CFME|CFPU|CHWD|CRME|CRPU|DIIO|DIME|DIPU|DSIO|DSME|DSPU|DTIO|DTME|DTPU|EDME|ENIO|ENME|ENPU|EXAP|LDME|LDPR|LDSC|LDSS|NMI|NWPR|NWSC|RNIO|RSAP|RSIO|RSME|RSPU|RST|RUN|RUSC|RWIO|SESC|SHBL|SHBM|SHHV|SHIL|SHIO|SHME|SHRL|SHRV|SHSC|SHSE|STEP|STOP|STSC|SVME|SVPR|SVSC|SVSS|ADD|AND|BIT|CALL|COMP|CONV|DEC|DEPO|END|EXAM|EXIT|HELP|INC|INRG|JPEQ|JPZR|JPGE|JPGT|JPLE|JPLT|JPNE|JPNZ|MUL|NOT|OR|PRNT|RTRN|SHL|SHR|SUB|SWAP|WAIT|XOR)\>"

## strings:
color brightyellow "["][^"]*[^\\]["]"

## comments:
icolor brightgreen "^;.*|[[:space:]];.*$"

# preprocessor commands:
icolor brightcyan "^#!/.*|[[:space:]]#.*$"
icolor brightcyan "^@.*|[[:space:]]#.*$"
icolor brightcyan "^:.*|[[:space:]]#.*$"
