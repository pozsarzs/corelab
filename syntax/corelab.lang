    <!-- registers: -->
    <context id="constant" style-ref="constant">
      <match>(?i)\$R[A-F0-9]\b</match>
    </context>
    <context id="corelab" class="no-spell-check">
      <include>
        <context ref="comment"/>
        <context ref="string"/>
        <context ref="constant"/>
        <context ref="keyword"/>
      </include>
    </context>
