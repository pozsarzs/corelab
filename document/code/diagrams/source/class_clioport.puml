@startuml

title CLIOPort application class diagram

skinparam classAttributeIconSize 0
skinparam diagramBorderColor black
skinparam diagramBorderThickness 1
'skinparam linetype ortho
skinparam nodesep 10
skinparam packageStyle rectangle
skinparam ranksep 10
skinparam shadowing false
skinparam monochrome true

left to right direction

' ============================================================
' Plugin metadata
' ============================================================

class TPluginAttributes <<record>> {
    PFilename: string
    PModname: string
    PDescription: string
    PAddressRangeSize: Byte
    PBaseAddress: Byte
    PIntVector: Byte
    PHasPanel: Boolean
    PEnabled: Boolean
    PLatchedOutput: Boolean
    PReadBackOutput: Boolean
    PDataInMode: TLineMode
    PDataInNegation: Boolean
    PDataOutMode: TLineMode
    PDataOutNegation: Boolean
    PSelMode: TLineMode
    PSelNegation: Boolean
}

enum TOpDirection {
    opPlugin2Var
    opVar2List
    opList2Var
    opVar2Plugin
}

' ============================================================
' Plugin entry points
' ============================================================

interface TCreatePortFunc {
    {static} CreatePort(): TIOPort
}

interface TDestroyPortProc {
    {static} DestroyPort(Port: TIOPort)
}

interface TCreatePanelProc {
    {static} CreatePanel(Port: TIOPort)
}

interface TShowPanelProc {
    {static} ShowPanel(Port: TIOPort)
}

interface THidePanelProc {
    {static} HidePanel(Port: TIOPort)
}

interface TFreePanelProc {
    {static} FreePanel(Port: TIOPort)
}

interface TRenamePanelProc {
    {static} RenamePanel(Port: TIOPort, Caption: PChar)
}

interface TResizePanelProc {
    {static} ResizePanel(
        Port: TIOPort,
        Width: Integer,
        Height: Integer
    ): Boolean
}

interface TMovePanelProc {
    {static} MovePanel(
        Port: TIOPort,
        Left: Integer,
        Top: Integer
    ): Boolean
}

interface TSetIntHandler {
    {static} SetIntHandler(
        Port: TIOPort,
        IntProc: TInterruptCallback,
        IntVector: Byte
    )
}

interface TLoadStateProc {
    {static} LoadState(
        Port: TIOPort,
        AStream: TStream
    ): Boolean
}

interface TSaveStateProc {
    {static} SaveState(
        Port: TIOPort,
        AStream: TStream
    ): Boolean
}

' ============================================================
' External plugin port classes
' ============================================================

class TIOPort <<external>> {
    +AddressRangeSize: Byte
    +BaseAddress: Byte
    +DataInMode: TLineMode
    +DataInNegation: Boolean
    +DataOutMode: TLineMode
    +DataOutNegation: Boolean
    +Enabled: Boolean
    +HasPanel: Boolean
    +IntVector: Byte
    +LatchedOutput: Boolean
    +ReadBackOutput: Boolean
    +SelMode: TLineMode
    +SelNegation: Boolean
    +Modname: PChar
    +Description: PChar

    +ReadPort(Address: Byte): Byte
    +WritePort(Address: Byte, Data: Integer)
}

class TGIOPort <<external>> {
    +PanelCaption: string
    +PanelHeight: Integer
    +PanelWidth: Integer
    +PanelLeft: Integer
    +PanelTop: Integer
}

TIOPort <|-- TGIOPort

' ============================================================
' Main application
' ============================================================

class TForm1 {
    -CurrentPort: TIOPort
    -LoadedPlugin: TPluginAttributes

    -CreatePort: TCreatePortFunc
    -DestroyPort: TDestroyPortProc

    -CreatePanel: TCreatePanelProc
    -ShowPanel: TShowPanelProc
    -HidePanel: THidePanelProc
    -FreePanel: TFreePanelProc
    -RenamePanel: TRenamePanelProc
    -ResizePanel: TResizePanelProc
    -MovePanel: TMovePanelProc

    -SetIntHandler: TSetIntHandler
    -LoadState: TLoadStateProc
    -SaveState: TSaveStateProc

    -ImpExpProperties(Direction: TOpDirection)
    -RefreshProperties(Direction: TOpDirection)
    -SetPluginDirectory(APluginDirectory: string)

    +LoadChangePluginExecute()
    +ShowPluginWindowExecute()
    +SetPluginWindowCaptionExecute()
    +SetPluginWindowSizePositionExecute()
    +ReadAByteExecute()
    +WriteAByteExecute()
    +LoadStatusExecute()
    +SaveStatusExecute()
}

' ============================================================
' Panel configuration forms
' ============================================================

class TForm3 {
    -GetCaption(): string
    -SetCaption(Title: string)
    +PanelCaption: string
}

class TForm4 {
    -GetHeightValue(): Integer
    -GetLeftValue(): Integer
    -GetTopValue(): Integer
    -GetWidthValue(): Integer

    -SetHeightValue(Value: Integer)
    -SetLeftValue(Value: Integer)
    -SetTopValue(Value: Integer)
    -SetWidthValue(Value: Integer)

    +PanelHeight: Integer
    +PanelLeft: Integer
    +PanelTop: Integer
    +PanelWidth: Integer
}

' ============================================================
' Relationships
' ============================================================

TForm1 *-- TPluginAttributes
TForm1 o-- TIOPort

TForm1 ..> TCreatePortFunc
TForm1 ..> TDestroyPortProc
TForm1 ..> TCreatePanelProc
TForm1 ..> TShowPanelProc
TForm1 ..> THidePanelProc
TForm1 ..> TFreePanelProc
TForm1 ..> TRenamePanelProc
TForm1 ..> TResizePanelProc
TForm1 ..> TMovePanelProc
TForm1 ..> TSetIntHandler
TForm1 ..> TLoadStateProc
TForm1 ..> TSaveStateProc

TForm1 ..> TGIOPort : panel properties

TForm1 --> TForm3 : panel caption
TForm1 --> TForm4 : panel size/position

TForm1 ..> TOpDirection

TCreatePortFunc ..> TIOPort
TDestroyPortProc ..> TIOPort
TCreatePanelProc ..> TIOPort
TShowPanelProc ..> TIOPort
THidePanelProc ..> TIOPort
TFreePanelProc ..> TIOPort
TRenamePanelProc ..> TIOPort
TResizePanelProc ..> TIOPort
TMovePanelProc ..> TIOPort
TSetIntHandler ..> TIOPort
TLoadStateProc ..> TIOPort
TSaveStateProc ..> TIOPort

@enduml
