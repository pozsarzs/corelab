@startuml

title CLMemory application class diagram

skinparam classAttributeIconSize 0
skinparam diagramBorderColor black
skinparam diagramBorderThickness 1
'skinparam linetype ortho
skinparam nodesep 10
skinparam packageStyle rectangle
skinparam ranksep 10
skinparam shadowing false
left to right direction
skinparam monochrome true

' ============================================================
' Plugin metadata
' ============================================================

class TPluginAttributes <<record>> {
    PFilename: string
    PAddressRangeSize: DWord
    PDescription: string
    PEnabled: Boolean
    PInstanceID: Integer
    PMemoryMode: TMemoryMode
    PModname: string
}

enum TOpDirection {
    opPlugin2Var
    opVar2List
    opList2Var
    opVar2Plugin
}

' ============================================================
' Plugin entry points
' ============================================================

interface TCreateMemoryFunc {
    {static} CreateMemory(): TMemory
}

interface TDestroyMemoryProc {
    {static} DestroyMemory(Memory: TMemory)
}

interface TLoadStateProc {
    {static} LoadState(
        Memory: TMemory,
        AStream: TStream
    ): Boolean
}

interface TSaveStateProc {
    {static} SaveState(
        Memory: TMemory,
        AStream: TStream
    ): Boolean
}

' ============================================================
' External plugin class
' ============================================================

class TMemory <<plugin / external>> {
    +InstanceID: Integer
    +AddressRangeSize: DWord
    +Enabled: Boolean
    +MemoryMode: TMemoryMode
    +Modname: PChar
    +Description: PChar

    +ReadMemory(Address: DWord): Byte
    +WriteMemory(Address: DWord, Data: Integer)
}

' ============================================================
' Main application
' ============================================================

class TForm1 {
    -CurrentMemory: TMemory
    -LibHandle: TLibHandle
    -LoadedPlugin: TPluginAttributes

    -CreateMemory: TCreateMemoryFunc
    -DestroyMemory: TDestroyMemoryProc
    -LoadState: TLoadStateProc
    -SaveState: TSaveStateProc

    -ImpExpProperties(Direction: TOpDirection)
    -RefreshProperties(Direction: TOpDirection)
    -SetPluginDirectory(APluginDirectory: string)

    +LoadChangePluginExecute(Sender: TObject)
    +ExamineExecute(Sender: TObject)
    +DepositExecute(Sender: TObject)
    +LoadStatusExecute(Sender: TObject)
    +SaveStatusExecute(Sender: TObject)

    +FormCreate(Sender: TObject)
    +FormDestroy(Sender: TObject)
}

' ============================================================
' Relationships
' ============================================================

TForm1 *-- TPluginAttributes
TForm1 o-- TMemory

TForm1 ..> TCreateMemoryFunc
TForm1 ..> TDestroyMemoryProc
TForm1 ..> TLoadStateProc
TForm1 ..> TSaveStateProc
TForm1 ..> TOpDirection

TCreateMemoryFunc ..> TMemory
TDestroyMemoryProc ..> TMemory
TLoadStateProc ..> TMemory
TSaveStateProc ..> TMemory

TForm1 ..> TMemory : plugin operations
TForm1 ..> TStream : state data

@enduml
