@startuml
title CoreLAB Memory plugin class diagram

skinparam classAttributeIconSize 0
skinparam diagramBorderColor black
skinparam diagramBorderThickness 1
'skinparam linetype ortho
skinparam nodesep 10
skinparam packageStyle rectangle
skinparam ranksep 10
skinparam shadowing false
skinparam monochrome true
left to right direction

package "core_memory" {

  class TMemory <<class>> {
    {field} #FAddressRangeSize: DWord
    {field} #FBaseAddress: DWord
    {field} #FBusType: TBusType
    {field} #FDescription: PChar
    {field} #FEnabled: Boolean
    {field} #FMemoryMode: TMemoryMode
    {field} #FMemCells: array of Byte
    {field} #FModname: PChar
    {field} #FVersion: TSemanticVersion
    {field} #FOnDestroy: TMemoryDestroyEvent
    --
    {method} +Create()
    {method} +Destroy()
    {method} +ReadMemory(AAddress: DWord): Byte
    {method} +WriteMemory(AAddress: DWord, AValue: Byte): procedure
    {method} +Reset(): procedure
    {method} +LoadState(AStream: TStream): Boolean
    {method} +SaveState(AStream: TStream): Boolean
    {method} +LoadFromStream(AStream: TStream, AAddress: DWord, ACount: DWord): procedure
    {method} +SaveToStream(AStream: TStream, AAddress: DWord, ACount: DWord): procedure
    --
    {property} +AddressRangeSize: DWord
    {property} +BaseAddress: DWord
    {property} +BusType: TBusType
    {property} +Description: PChar
    {property} +Enabled: Boolean
    {property} +MemoryMode: TMemoryMode
    {property} +ModName: PChar
    {property} +Version: TSemanticVersion
    {property} +OnDestroy: TMemoryDestroyEvent
    --
    {method} #SetFAddressRangeSize(AAddressRangeSize: DWord): procedure
    {method} #SetFBaseAddress(ABaseAddress: DWord): procedure
    {method} #SetFMemoryMode(AMemoryMode: TMemoryMode): procedure
  }

  class TMemoryDestroyEvent <<procedure type>> {
    Sender: TMemory
  }

  enum TMemoryMode {
    mmRAM
    mmROM
  }

  class TMemoryModeHelper <<type helper>> {
    +ToString(): string
    +FromString(const Value: string): TMemoryMode
  }

  class TSemanticVersion <<record>> {
    Major: Integer
    Minor: Integer
    Patch: Integer
  }

  class TSemanticVersionHelper <<type helper>> {
    +ToString(): string
    +Compare(AOther: TSemanticVersion): Integer
  }

  class "core_bus.TBusType" as TBusType <<external type>>
}

TMemory ..> TMemoryMode : uses
TMemory ..> TSemanticVersion : stores
TMemory ..> TBusType : uses
TMemory ..> TMemoryDestroyEvent : callback
TMemoryModeHelper ..> TMemoryMode : extends
TSemanticVersionHelper ..> TSemanticVersion : extends
TMemoryDestroyEvent ..> TMemory : Sender

note right of TMemory
  Constructor defaults:
  - AddressRangeSize = 1024
  - BaseAddress = 0
  - BusType = btStandard
  - Enabled = False
  - MemoryMode = mmRAM
  - Version = 0.1.0

  Address range is capped at 16 MiB.
  Writes are accepted only in RAM mode.
end note

@enduml
