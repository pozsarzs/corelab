@startuml
title CoreLAB CPU Class Diagram

left to right direction
skinparam classAttributeIconSize 0
skinparam diagramBorderColor black
skinparam diagramBorderThickness 1
'skinparam linetype ortho
skinparam nodesep 10
skinparam packageStyle rectangle
skinparam ranksep 10
skinparam shadowing false

package "CPU Architecture" {

  abstract class TCPU {
    # FBus : ISysBus
    # FInstanceID : Integer
    # FOnEvent : TCPUEventHandler
    # FModname : PChar
    # FDescription : PChar
    # FVersion : TSemanticVersion
    # FArchitecture : TArchitecture
    # FBitWidth : Byte
    # FAddressWidth : Byte
    # FEnabled : Boolean
    # FEndianness : TEndianness
    # FMaxMemAddress : QWord
    # FMaxCodeAddress : QWord
    # FMaxIOPortAddress : QWord
    # FHasSeparateIOBus : Boolean
    # FRunning : Boolean
    # FHalted : Boolean
    # FInterruptEnabled : Boolean
    # FIRPending : Boolean
    # FNMIpending : Boolean
    # FCycles : QWord
    # FInstructions : QWord
    # FRegPtr : array of ^QWord
    --
    # EmitEvent(AEvent: TCPUEvent)
    # DoInterrupt(AEvent: TCPUEvent)
    --
    + Create
    + Destroy
    + ConnectBus(Bus: ISysBus)
    + SetRegister(RegName: PChar; AValue: QWord)
    + GetRegister(RegName: PChar): QWord
    + Reset
    + Run
    + Step
    + Stop
    + GetCurrentInstruction: PChar
    + IRQ
    + NMI
    + CheckInterrupts: Boolean
    + LoadState(AStream: TStream): Boolean
    + SaveState(AStream: TStream): Boolean
    --
    + AddressWidth : Byte
    + Architecture : TArchitecture
    + BitWidth : Byte
    + Cycles : QWord
    + Description : PChar
    + Enabled : Boolean
    + Endianness : TEndianness
    + Halted : Boolean
    + HasSeparateIOBus : Boolean
    + InstanceID : Integer
    + Instructions : QWord
    + InterruptEnabled : Boolean
    + MaxCodeAddress : QWord
    + MaxIOPortAddress : QWord
    + MaxMemAddress : QWord
    + Modname : PChar
    + OnEvent : TCPUEventHandler
    + Running : Boolean
    + Version : TSemanticVersion
  }

  class T8080CPU {
    # FRegs : T8080Registers
    # LogRecord : TLastInstruction
    # RegPointers : array[0..7] of PByte
    # s : string
    --
    # UpdateFlags(Value16: Word; OldValue, ValueToAdd: Byte)
    --
    + Create
    + Reset
    + LoadState(AStream: TStream): Boolean
    + SaveState(AStream: TStream): Boolean
    + Step
    + GetCurrentInstruction: PChar
    + GetRegister(RegName: PChar): QWord
    + SetRegister(RegName: PChar; Value: QWord)
  }

  class T8080Registers <<record>> {
    + BC : Word
    + DE : Word
    + HL : Word
    + AF : Word
    + PC : Word
    + SP : Word
    --
    + B : Byte
    + C : Byte
    + D : Byte
    + E : Byte
    + H : Byte
    + L : Byte
    + F : Byte
    + A : Byte
    + PCL : Byte
    + PCH : Byte
    + SPL : Byte
    + SPH : Byte
  }

  class TLastInstruction <<record>> {
    + Address : Word
    + Opcode : Byte
    + NumOperand : Byte
    + Operands : array[1..2] of Word
    + Mnemonic : string[12]
  }

  enum TArchitecture {
    arHarvad
    arNeumann
  }

  enum TEndianness {
    enLittle
    enBig
  }

  enum TCPUEvent {
    ceInstructionBoundary
    ceInterrupt
    ceHalt
    ceReset
  }

  interface ISysBus {
    + MemRead(AAddress: UInt64): Byte
    + MemWrite(AAddress: UInt64; AValue: Byte)
    + CodeRead(AAddress: UInt64): Byte
    + CodeWrite(AAddress: UInt64; AValue: Byte)
    + IORead(APort: UInt64): Byte
    + IOWrite(APort: UInt64; AValue: Byte)
  }

  TCPU <|-- T8080CPU
  T8080CPU *-- T8080Registers
  T8080CPU *-- TLastInstruction

  TCPU ..> ISysBus : uses
  TCPU ..> TArchitecture
  TCPU ..> TEndianness
  TCPU ..> TCPUEvent

  note right of T8080CPU
    Intel 8080 implementation

    Module: 8080
    Bit width: 8
    Address width: 16
    Endianness: Little
    Architecture: von Neumann
    Memory: $0000..$FFFF
    I/O: $00..$FF
  end note
}

@enduml
