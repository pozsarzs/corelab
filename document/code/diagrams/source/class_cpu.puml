@startuml
title CoreLAB CPU Class Diagram

left to right direction
skinparam classAttributeIconSize 0
skinparam diagramBorderColor black
skinparam diagramBorderThickness 1
'skinparam linetype ortho
skinparam nodesep 10
skinparam packageStyle rectangle
skinparam ranksep 10
skinparam shadowing false
skinparam monochrome true

' ============================================================
' Common CPU types
' ============================================================

enum TArchitecture {
    arHarvard
    arNeumann
}

enum TEndianness {
    enLittle
    enBig
}

enum TCPUEvent {
    ceInstructionBoundary
    ceInterrupt
    ceHalt
    ceReset
}

class TSemanticVersion <<record>> {
    Major: Integer
    Minor: Integer
    Patch: Integer

    ToString(): string
    Compare(AOther: TSemanticVersion): Integer
}

class TLogRec <<record>> {
    InstCount: Integer
    Address: string
    OpCode: string
    Mnemonic: string
}

' ============================================================
' Event handling
' ============================================================

interface TCPUEventHandler <<procedure type>> {
    (Sender: TObject, Event: TCPUEvent)
}

' ============================================================
' System bus
' ============================================================

interface ISysBus <<external>> {
    ReadMemory(Address: DWord): Byte
    WriteMemory(Address: DWord, Data: Byte)
}

' ============================================================
' Abstract CPU base class
' ============================================================

abstract class TCPU {
    #FBus: ISysBus
    #FOnEvent: TCPUEventHandler

    #FModname: PChar
    #FDescription: PChar
    #FVersion: TSemanticVersion

    #FAddressWidth: Byte
    #FArchitecture: TArchitecture
    #FEnabled: Boolean
    #FEndianness: TEndianness
    #FMaxCodeAddress: DWord
    #FMaxIOPortAddress: DWord
    #FMaxMemAddress: DWord
    #FHasSeparateIOBus: Boolean

    #FRunning: Boolean
    #FHalted: Boolean
    #FInterruptEnabled: Boolean
    #FIRQPending: Boolean
    #FIRQVector: Byte
    #FNMIPending: Boolean

    #FCycles: QWord
    #FInstructions: QWord

    #FRegPtr: array of ^Word

    #EmitEvent(AEvent: TCPUEvent): virtual
    #DoInterrupt(AEvent: TCPUEvent): virtual

    +ConnectBus(const Bus: ISysBus): virtual

    +Create()
    +Destroy()

    +SetRegister(RegName: PChar, AValue: Word): virtual {abstract}
    +GetRegister(RegName: PChar): Word: virtual {abstract}
    +GetRegisterCount(): Byte: virtual {abstract}
    +GetRegisterName(AIndex: Byte): PChar: virtual {abstract}
    +GetRegisterSize(AIndex: Byte): Byte: virtual {abstract}

    +Run(): virtual
    +Step(): virtual {abstract}
    +Stop(): virtual

    +GetCurrentInstruction(): TLogRec: virtual {abstract}

    +IRQ(AVector: Byte): virtual
    +NMI(): virtual
    +CheckInterrupts(): Boolean

    +Reset(): virtual {abstract}
    +LoadState(AStream: TStream): Boolean: virtual {abstract}
    +SaveState(AStream: TStream): Boolean: virtual {abstract}

    +AddressWidth: Byte
    +Architecture: TArchitecture
    +Cycles: QWord
    +Description: PChar
    +Enabled: Boolean
    +Endianness: TEndianness
    +Halted: Boolean
    +HasSeparateIOBus: Boolean
    +Instructions: QWord
    +InterruptEnabled: Boolean
    +MaxCodeAddress: DWord
    +MaxIOPortAddress: DWord
    +MaxMemAddress: DWord
    +Modname: PChar
    +OnEvent: TCPUEventHandler
    +Running: Boolean
    +Version: TSemanticVersion
}

' ============================================================
' Intel 8080
' ============================================================

class T8080Registers <<record>> {
    BC: Word
    DE: Word
    HL: Word
    AF: Word
    PC: Word
    SP: Word

    C: Byte
    B: Byte
    E: Byte
    D: Byte
    L: Byte
    H: Byte
    F: Byte
    A: Byte

    PCL: Byte
    PCH: Byte
    SPL: Byte
    SPH: Byte
}

class TLastInstruction <<record>> {
    Address: Word
    Opcode: Byte
    NumOperand: Byte
    Operands: Word[1..2]
    Mnemonic: string
}

class T8080CPU {
    -LogRecord: TLastInstruction
    -RegPointers: array[0..7] of PByte

    #FRegs: T8080Registers

    #UpdateFlags(
        Value16: Word,
        OldValue: Byte,
        ValueToAdd: Byte
    )

    #DoInterrupt(AEvent: TCPUEvent): override

    +Create(): override

    +Reset(): override
    +LoadState(AStream: TStream): Boolean: override
    +SaveState(AStream: TStream): Boolean: override

    +Step(): override
    +GetCurrentInstruction(): TLogRec: override
    +GetRegister(RegName: PChar): Word: override
    +SetRegister(RegName: PChar, Value: Word): override
    +GetRegisterCount(): Byte: override
    +GetRegisterName(AIndex: Byte): PChar: override
    +GetRegisterSize(AIndex: Byte): Byte: override
}

' ============================================================
' Relationships
' ============================================================

T8080CPU --|> TCPU

TCPU o-- ISysBus
TCPU o-- TCPUEventHandler
TCPU *-- TSemanticVersion

TCPU ..> TArchitecture
TCPU ..> TEndianness
TCPU ..> TCPUEvent
TCPU ..> TLogRec

T8080CPU *-- T8080Registers
T8080CPU *-- TLastInstruction

T8080CPU ..> TCPUEvent
T8080CPU ..> ISysBus
T8080CPU ..> TLogRec

note right of TCPU
  Abstract CPU interface.
  Concrete processors implement this
  class.

  The common control and
  service API is
  defined here.
end note

note right of T8080CPU
  First CPU implementation.

  Other CPUs for example:

  T4004CPU --|> TCPU
  T4040CPU --|> TCPU
  T8008CPU --|> TCPU
  TZ80CPU --|> TCPU
end note

@enduml
