@startuml
title CoreLAB CPU Class Diagram

left to right direction
skinparam classAttributeIconSize 0
skinparam diagramBorderColor black
skinparam diagramBorderThickness 1
'skinparam linetype ortho
skinparam nodesep 10
skinparam packageStyle rectangle
skinparam ranksep 10
skinparam shadowing false
skinparam monochrome true

package "core_cpu" {
  enum TArchitecture {
    arHarvard
    arNeumann
  }

  enum TEndianness {
    enLittle
    enBig
  }

  enum TCPUEvent {
    ceInstructionBoundary
    ceInterrupt
    ceHalt
    ceReset
  }

  class TSemanticVersion <<record>> {
    +Major: Integer
    +Minor: Integer
    +Patch: Integer
  }

  class TLastInstruction <<record>> {
    +Address: Word
    +Opcode: Byte
    +NumPrefix: Byte
    +Prefixes: Word[2]
    +NumOperand: Byte
    +Operands: Word[2]
    +Mnemonic: string[32]
    +Cycles: Byte
  }

  class TLogRec <<record>> {
    +InstCount: Integer
    +Address: string[32]
    +OpCode: string[32]
    +Mnemonic: string[32]
    +Cycles: Byte
    +TotalCycles: QWord
  }

  class TIntLogRec <<record>> {
    +Sender: string[32]
    +Vector: string[32]
    +Status: string[32]
    +Flag: string[32]
  }

  class TCPUEventHandler <<procedure type>>
  class TProcessorDestroyEvent <<procedure type>>

  class TArchitectureHelper <<type helper>> {
    +ToString(): string
    +FromString(Value: string): TArchitecture
  }

  class TEndiannessHelper <<type helper>> {
    +ToString(): string
    +FromString(Value: string): TEndianness
  }

  class TCPUEventHelper <<type helper>> {
    +ToString(): string
    +FromString(Value: string): TCPUEvent
  }

  class TSemanticVersionHelper <<type helper>> {
    +ToString(): string
    +Compare(AOther: TSemanticVersion): Integer
  }

  abstract class TCPU {
    {field} #FOnEvent: TCPUEventHandler
    {field} #FModname: PChar
    {field} #FDescription: PChar
    {field} #FVersion: TSemanticVersion
    {field} #FAddressWidth: Byte
    {field} #FArchitecture: TArchitecture
    {field} #FBusType: TBusType
    {field} #FDefaultClockFreq: DWord
    {field} #FEnabled: Boolean
    {field} #FEndianness: TEndianness
    {field} #FLastInstruction: TLastInstruction
    {field} #FMaxCodeAddress: DWord
    {field} #FMaxIOPortAddress: DWord
    {field} #FMaxMemAddress: DWord
    {field} #FHasSeparateIOBus: Boolean
    {field} #FRunning: Boolean
    {field} #FHalted: Boolean
    {field} #FInterruptEnabled: Boolean
    {field} #FIRQPending: Boolean[8]
    {field} #FIRQVector: Byte[8]
    {field} #FNMIPending: Boolean
    {field} #FTotalCycles: QWord
    {field} #FTotalInstructions: QWord
    {field} #FOnDestroy: TProcessorDestroyEvent
    {field} #FRegPtr: array of ^Word

    {method} #EmitEvent(AEvent: TCPUEvent): void <<virtual>>
    {method} #DoInterrupt(AEvent: TCPUEvent, AMode: Byte = 0): void <<virtual>>

    +ConnectBus(ABus: IInterface): Boolean <<abstract, virtual>>
    +TCPU()
    +Destroy()
    +CheckInterrupts(): Boolean <<virtual>>
    +GetCurrentInstruction(): TLogRec <<abstract, virtual>>
    +GetCurrentInterrupt(AMode: Byte = 0): TIntLogRec <<virtual>>
    +GetRegister(RegName: PChar): Word <<abstract, virtual>>
    +GetRegisterCount(): Byte <<abstract, virtual>>
    +GetRegisterName(AIndex: Byte): PChar <<abstract, virtual>>
    +GetRegisterSize(AIndex: Byte): Byte <<abstract, virtual>>
    +LoadState(AStream: TStream): Boolean <<abstract, virtual>>
    +SaveState(AStream: TStream): Boolean <<abstract, virtual>>
    +IRQ(AVector: Byte, AMode: Byte = 0): void <<virtual>>
    +NMI(): void <<virtual>>
    +Reset(): void <<abstract, virtual>>
    +Run(): void <<virtual>>
    +SetRegister(RegName: PChar, AValue: Word): void <<abstract, virtual>>
    +Step(): void <<abstract, virtual>>
    +Stop(): void <<virtual>>

    +AddressWidth: Byte {read-only}
    +Architecture: TArchitecture {read-only}
    +BusType: TBusType {read-only}
    +DefaultClockFreq: DWord {read-only}
    +TotalCycles: QWord {read-only}
    +Description: PChar {read-only}
    +Enabled: Boolean {read-write}
    +Endianness: TEndianness {read-only}
    +Halted: Boolean {read-only}
    +HasSeparateIOBus: Boolean {read-only}
    +TotalInstructions: QWord {read-only}
    +InterruptEnabled: Boolean {read-only}
    +MaxCodeAddress: DWord {read-only}
    +MaxIOPortAddress: DWord {read-only}
    +MaxMemAddress: DWord {read-only}
    +Modname: PChar {read-only}
    +OnEvent: TCPUEventHandler {read-write}
    +Running: Boolean {read-only}
    +Version: TSemanticVersion {read-only}
    +OnDestroy: TProcessorDestroyEvent {read-write}
  }
}

package "core_bus (external unit)" {
  enum TBusType {
    btStandard
    btMCS4
  }
}

TCPU --> TBusType : FBusType
TCPU --> TArchitecture
TCPU --> TEndianness
TCPU --> TCPUEvent
TCPU *-- TSemanticVersion : FVersion
TCPU *-- TLastInstruction : FLastInstruction
TCPU ..> TLogRec : returns
TCPU ..> TIntLogRec : returns
TCPU ..> TCPUEventHandler : callback
TCPU ..> TProcessorDestroyEvent : callback

TArchitectureHelper ..> TArchitecture : extends
TEndiannessHelper ..> TEndianness : extends
TCPUEventHelper ..> TCPUEvent : extends
TSemanticVersionHelper ..> TSemanticVersion : extends

note right of TCPU
  Abstract base class.

  IRQ channels: 0..7.
  CheckInterrupts handles NMI first,
  then the first enabled pending IRQ
  in ascending channel order.
  One interrupt is accepted per call.

  The constructor initializes execution
  and interrupt state, counters, bus type
  (btStandard), default clock frequency
  (1,000,000 Hz) and version (0.1.0).
end note

note bottom of TProcessorDestroyEvent
  procedure(Sender: TCPU) of object
end note

note bottom of TCPUEventHandler
  procedure(Sender: TObject; Event: TCPUEvent) of object
end note

@enduml
