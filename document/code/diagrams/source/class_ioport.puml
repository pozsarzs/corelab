@startuml
title CoreLAB I/O port plugin class diagram

skinparam classAttributeIconSize 0
skinparam diagramBorderColor black
skinparam diagramBorderThickness 1
'skinparam linetype ortho
skinparam nodesep 10
skinparam packageStyle rectangle
skinparam ranksep 10
skinparam shadowing false
skinparam monochrome true
left to right direction

package "core_ioport" {

  abstract class TIOPort {
    {field} #FAddressRangeSize: DWord
    {field} #FBaseAddress: DWord
    {field} #FBusType: TBusType
    {field} #FDataInMode: TLineMode
    {field} #FDataInNegation: Boolean
    {field} #FDataOutMode: TLineMode
    {field} #FDataOutNegation: Boolean
    {field} #FDescription: PChar
    {field} #FEnabled: Boolean
    {field} #FHasPanel: Boolean
    {field} #FInstanceID: Integer
    {field} #FIntVector: Byte
    {field} #FLatchedOutput: Boolean
    {field} #FModname: PChar
    {field} #FOnInterrupt: TInterruptCallback
    {field} #FReadBackOutput: Boolean
    {field} #FSelMode: TLineMode
    {field} #FSelNegation: Boolean
    {field} #FVersion: TSemanticVersion
    --
    {method} +Create()
    {method} +Destroy()
    {method} +ReadPort(APort: Word): Byte
    {method} +WritePort(APort: Word, AValue: Byte)
    {method} +Reset()
    {method} +LoadState(AStream: TStream): Boolean
    {method} +SaveState(AStream: TStream): Boolean
    --
    {method} #RequestInterrupt()
    --
    {property} +AddressRangeSize: DWord
    {property} +BaseAddress: DWord
    {property} +BusType: TBusType
    {property} +DataInMode: TLineMode
    {property} +DataInNegation: Boolean
    {property} +DataOutMode: TLineMode
    {property} +DataOutNegation: Boolean
    {property} +Description: PChar
    {property} +Enabled: Boolean
    {property} +HasPanel: Boolean
    {property} +IntVector: Byte
    {property} +LatchedOutput: Boolean
    {property} +ModName: PChar
    {property} +OnInterrupt: TInterruptCallback
    {property} +ReadBackOutput: Boolean
    {property} +SelMode: TLineMode
    {property} +SelNegation: Boolean
    {property} +Version: TSemanticVersion
  }

  enum TLineMode {
    lmDirect
    lmBCD
  }

  class TLineModeHelper <<type helper>> {
    +ToString(): string
    +FromString(const Value: string): TLineMode
  }

  class TSemanticVersion <<record>> {
    Major: Integer
    Minor: Integer
    Patch: Integer
  }

  class TSemanticVersionHelper <<type helper>> {
    +ToString(): string
    +Compare(AOther: TSemanticVersion): Integer
  }

  class TInterruptCallback <<procedure type>> {
    Sender: TIOPort
    Vector: Byte
  }

  class "core_bus.TBusType" as TBusType <<external type>>
}

TIOPort ..> TLineMode : uses
TIOPort ..> TSemanticVersion : stores
TIOPort ..> TBusType : uses
TIOPort ..> TInterruptCallback : callback
TLineModeHelper ..> TLineMode : extends
TSemanticVersionHelper ..> TSemanticVersion : extends
TInterruptCallback ..> TIOPort : Sender

note right of TIOPort
  Abstract base class.
  ReadPort, WritePort and Reset are
  abstract virtual methods.

  RequestInterrupt invokes OnInterrupt
  only when the port is enabled and
  a callback is assigned.

  Constructor defaults:
  - AddressRangeSize = 1
  - BaseAddress = 0
  - BusType = btStandard
  - DataInMode = lmBCD
  - DataOutMode = lmBCD
  - SelMode = lmBCD
  - Enabled = False
  - IntVector = 0
  - Version = 0.1.0
end note

note bottom of TIOPort
  SaveState does not serialize the OnInterrupt
  method pointer; it must be assigned separately.
end note

@enduml
