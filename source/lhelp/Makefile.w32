name = lhelp
architecture = i386
os = win32
fpc = ppc386
lcldir = c:\lazarus\lcl
outdir = .\lib\$(architecture)-$(os)
fpcargs = -T$(os) \
          -MObjFPC \
          -Scgi \
          -O1 \
          -v0 \
          -Fu. \
          -Fu$(lcldir)/../components/chmhelp/packages/help/ \
          -Fu$(lcldir)/../components/lazutils/lib/$(architecture)-$(os)/ \
          -Fu$(lcldir)/../components/turbopower_ipro/ \
          -Fu$(lcldir)/../components/synedit/ \
          -Fu$(lcldir)/../packager/units/$(architecture)-$(os)/ \
          -Fu$(lcldir)/units/$(architecture)-$(os)/ \
          -Fu$(lcldir)/units/$(architecture)-$(os)/win32/ \
          -Fu$(outdir) \
          -FE$(outdir) \
          -dLCL \
          -dLCLwin32 \
          -WG

all:
	@if not exist .\lib\nul md .\_lib
	@if not exist $(outdir)\nul md $(outdir)
	@$(fpc) $(fpcargs) $(name).lpr
	@copy $(outdir)\$(name).exe ..\..

clean:
	@erase $(outdir)\*.*
