copyright	= @copyright@
name		= corelab
version		= @version@
libversion	= @libversion@
architecture	= @architecture@
os              = @os@

projectdir	= @abs_top_srcdir@
prefix		= @prefix@
bindir		= @bindir@
datarootdir	= @datarootdir@
exec_prefix	= @exec_prefix@
libdir		= @libdir@
localedir	= @datarootdir@/locale
mandir		= @mandir@
srcdir		= @srcdir@
sysconfdir	= @sysconfdir@
vardir		= @vardir@

binmode		= 0755
txtmode		= 0644

chmcmd		= @chmcmd@
fpc		= @fpc@
iconv		= @iconv@
install		= @install@
ln		= @ln@ -s -f
man		= @man@
make		= @make@
msgfmt		= @msgfmt@
rmdir		= @rmdir@
rm		= @rm@ -f
rstconv		= @rstconv@
unix2dos	= @unix2dos@

lclunits        = @lclunits@
app             = @app@
lib             = @lib@
lhelp           = @lhelp@
outdir          = ./lib/@architecture@-@os@/
podir           = ./po/

fpcargs		= -T@os@ \
                  -MObjFPC \
                  -Scgi \
                  -O1 \
                  -ve \
                  -Fi../_inc/ \
                  -Fi../_inc/* \
                  -Fi../corelab-parts/ \
                  -Fu../_ext/* \
                  -Fu../_ppu/ \
                  -Fu../_ppu/* \
                  -Fu../corelab-core/ \
                  -Fu../corelab-parts/ \
                  -Fu../corelab-plugins/ \
                  -Fu. \
                  -Fu./lib/@architecture@-@os@/ \
                  -Fu@lcldir@/../components/chmhelp/packages/help/ \
                  -Fu@lcldir@/../components/lazutils/lib/@architecture@-@os@/ \
                  -Fu@lcldir@/../components/turbopower_ipro/ \
                  -Fu@lcldir@/../components/synedit/ \
                  -Fu@lcldir@/../packager/units/@architecture@-@os@/ \
                  -Fu@lcldir@/units/@architecture@-@os@/ \
                  -Fu@lcldir@/units/@architecture@-@os@/gtk2/ \
                  -FE./lib/@architecture@-@os@/ \
                  -dLCL \
                  -dLCLgtk2

logfile = @abs_top_srcdir@/build.log

define addtobuildlog
	STATUS=$(2); \
	printf "%-70s" "Build $(1)..." >> $(logfile); \
	if [ "$$STATUS" = "0" ]; \
	  then echo '[ OK ]' >> $(logfile); \
	  else echo '[ERROR]' >> $(logfile); \
	fi
endef
